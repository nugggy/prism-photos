<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (android:dataExtractionRules). Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/prism_session.preferences_pb" />
        <exclude domain="file" path="datastore/prism_upload_settings.preferences_pb" />
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/prism_session.preferences_pb" />
        <exclude domain="file" path="datastore/prism_upload_settings.preferences_pb" />
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
